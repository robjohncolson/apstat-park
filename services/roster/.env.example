# services/roster/.env.example
# GENERATED by `node scripts/check-env.mjs --render-examples` from config/env-schema.json. Do not edit by hand.
# Copy to services/roster/.env (gitignored), or run `node scripts/setup.mjs` to generate one with fresh secrets.
# Validate with: node scripts/check-env.mjs roster
# Railway: Root Directory = services/roster; health check path = /health.

# ==================== Required: the service does not work correctly without these ====================
# Core Supabase project URL (identity.supabase_url).
# from identity.current.supabase_url
ROSTER_SUPABASE_URL=https://bzqbhtrurzzavhqbgqrs.supabase.co

# Core project service_role key. Server only. Bypasses RLS.
# secret
ROSTER_SUPABASE_SERVICE_KEY=

# HMAC secret for student session tokens. Rotating it signs every student out.
# secret; generated by setup.mjs (hex32); must equal relay ROSTER_TOKEN_SECRET
ROSTER_TOKEN_SECRET=

# x-teacher-secret header for enrollment routes.
# secret; generated by setup.mjs (passphrase)
ROSTER_TEACHER_SECRET=

# Teacher login key for the dashboards and the FRQ regrade workflow (GitHub secret
# APSTATS_TEACHER_KEY). The code falls back to an insecure default if unset, so it is required here.
# secret; generated by setup.mjs (passphrase)
TEACHER_KEY=

# Encrypts stored student passwords for the teacher console.
# secret; generated by setup.mjs (hex32)
ROSTER_PW_ENC_KEY=

# Server-to-server secret for grade writes from the relay's FRQ grader.
# secret; generated by setup.mjs (hex32); must equal relay ROSTER_GRADER_SECRET
ROSTER_GRADER_SECRET=

# Server-to-server secret for campaign key grants between roster and relay.
# secret; generated by setup.mjs (hex32); must equal relay PARK_KEY_GRANT_SECRET
PARK_KEY_GRANT_SECRET=

# Ed25519 private key (hex) that signs ledger receipts. The relay has its OWN issuer key; see
# REVIEW_GRANT_PUBKEY.
# secret; generated by setup.mjs (ed25519, base64 PKCS8 DER)
RECEIPT_ISSUER_PRIVATE_KEY=

# Encrypts teacher-held Doge paper wallets (wallet custody).
# secret; generated by setup.mjs (hex32)
WALLET_KEY_SECRET=

# Must be `true`. The v3 two-track grade engine is the only one the Desk understands.
USE_V3_GRADING=true

# ==================== Recommended: code defaults point at the ORIGINAL teacher's deployment or are unsafe ====================
# Relay service URL (identity.relay_url). Defaults to the original teacher's relay if unset.
# from identity.current.relay_url
PARK_RELAY_URL=https://curriculumrender-production.up.railway.app

# Relay service URL again: the relay hosts the AI grader.
# from identity.current.relay_url
FRQ_GRADER_URL=https://curriculumrender-production.up.railway.app

# `authoritative` in production; `shadow` to grade without writing.
FRQ_GRADE_MODE=authoritative

# Sections students may self-enrol into. Format `Key:Label;Key:Label`.
OPEN_SIGNUP_SECTIONS="PeriodB:Period B;PeriodE:Period E"

# Progress-check track in the grade. `true` for the full course.
PC_TRACK_ENABLED=true

# Project holding the PRIVATE `pc-figures` storage bucket. In production this is the core project.
# from identity.current.supabase_url
PC_FIGURES_SUPABASE_URL=https://bzqbhtrurzzavhqbgqrs.supabase.co

# service_role key of that project (signed URLs for figures).
# secret
PC_FIGURES_SUPABASE_SERVICE_KEY=

# Decks the fleet-trainer cloud save accepts.
TRAINER_DECK_ALLOWLIST=ap-stats-formulas,joyo-kanji,jlpt-n5,formula-lab,ap-stats-flashcards

# Public key matching the RELAY's RECEIPT_ISSUER_PRIVATE_KEY, so roster can verify AI review grants.
# Code ships a default for the original teacher's relay; set it after generating the relay's key.
REVIEW_GRANT_PUBKEY=

# ==================== Optional: tuning and extras ====================
# Proctor-mode header secret.
# secret
ROSTER_PROCTOR_SECRET=

# Comma list of student ids that get the FRQ grader first.
FRQ_CANARY_STUDENTS=

# Key for the Doge payout agent (tools/).
# secret
PAYOUT_AGENT_KEY=

# BlockCypher API token for on-chain Doge balance reads.
# secret
BLOCKCYPHER_TOKEN=

# Comma list of student ids allowed to propose wallet addresses.
STUDENT_WALLET_OPTIN=

# Comma list of old issuer public keys still trusted for replay.
RETIRED_ISSUER_PUBKEYS=

# Candy the teacher may stake per Study Break match.
TEACHER_STAKE_ALLOWANCE=100

# Max rows per Doge payout batch.
PAYOUT_BATCH_CAP=

# bcrypt cost factor for passwords (clamped by the code).
BCRYPT_COST=

# Rate limit: signup claims per window.
SIGNUP_CLAIM_MAX=

# Rate limit window for signup claims.
SIGNUP_CLAIM_WINDOW_MS=

# Rate limit: sign-in attempts per IP per window.
VERIFY_IP_MAX=

# Window for VERIFY_IP_MAX.
VERIFY_IP_WINDOW_MS=

# Failed sign-ins before lockout.
VERIFY_LOCKOUT_MAX=

# Lockout window.
VERIFY_LOCKOUT_WINDOW_MS=

# Rate limit for FRQ draft records.
FRQ_RECORD_MAX_PER_MINUTE=

# Rate limit for FRQ status polls.
FRQ_STATUS_MAX_PER_MINUTE=

# Rate limit for FRQ appeals.
FRQ_APPEAL_MAX_PER_MINUTE=

# ==================== Feature flags ====================
# Student-to-student candy gifts.
GIFTING_ENABLED=true

# Candy bets on Study Break (Tetris).
STAKES_ENABLED=true

# Gold premium on Tetris stakes.
STAKES_GOLD_PREMIUM=true

# Buy Pico Park campaign keys with candy.
KEY_PURCHASE_ENABLED=true

# Doge to candy cash-out.
BUYBACK_ENABLED=true

# Passive classroom network probe.
NET_PROBE_ENABLED=true

# ==================== Platform: injected by Railway, do not set by hand ====================
# Injected by Railway. Local default 8090.
# PORT=

# Injected by Railway; shown in /health.
# RAILWAY_GIT_COMMIT_SHA=

# ==================== Test only: never set these in production ====================
# Read only by the test suite; leave unset on Railway: GRADE_FREEZE_DIR, LESSON_SCHEDULE_PATH,
# ANSWER_KEY_PATH, SKILL_MAP_PATH, WORKSHEET_KEY_PATH, WORK_MANIFEST_PATH, PC_FIGURES_MANIFEST_PATH,
# NODE_ENV, VITEST.
