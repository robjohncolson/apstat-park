# services/relay/.env.example
# GENERATED by `node scripts/check-env.mjs --render-examples` from config/env-schema.json. Do not edit by hand.
# Copy to services/relay/.env (gitignored), or run `node scripts/setup.mjs` to generate one with fresh secrets.
# Validate with: node scripts/check-env.mjs relay
# Railway: Root Directory = services/relay; health check path = /health.

# ==================== Required: the service does not work correctly without these ====================
# Core Supabase project URL (identity.supabase_url). Code has a default for the original project;
# set it anyway.
# from identity.current.supabase_url
SUPABASE_URL=https://bzqbhtrurzzavhqbgqrs.supabase.co

# Core project anon key (public).
# from identity.current.supabase_anon_key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ6cWJodHJ1cnp6YXZocWJncXJzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTkxOTc1NDMsImV4cCI6MjA3NDc3MzU0M30.xDHsAxOlv0uprE9epz-M_Emn6q3mRegtTpFt0sl9uBo

# Core project service_role key. Server only.
# secret
SUPABASE_SERVICE_KEY=

# Same value as roster's ROSTER_TOKEN_SECRET, so the relay can verify student tokens.
# secret; must equal roster ROSTER_TOKEN_SECRET
ROSTER_TOKEN_SECRET=

# Same value as roster's.
# secret; must equal roster ROSTER_GRADER_SECRET
ROSTER_GRADER_SECRET=

# Same value as roster's.
# secret; must equal roster PARK_KEY_GRANT_SECRET
PARK_KEY_GRANT_SECRET=

# The RELAY's own Ed25519 issuer key (signs AI review grants). Its public key goes to roster's
# REVIEW_GRANT_PUBKEY.
# secret; generated by setup.mjs (ed25519, base64 PKCS8 DER)
RECEIPT_ISSUER_PRIVATE_KEY=

# AI provider for grading, appeals, tutor chat. At least one of GROQ_API_KEY / DEEPSEEK_API_KEY is
# required.
# secret; at least one of GROQ_API_KEY / DEEPSEEK_API_KEY
GROQ_API_KEY=

# Second AI provider (round-robin with failover).
# secret; at least one of GROQ_API_KEY / DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# ==================== Recommended: code defaults point at the ORIGINAL teacher's deployment or are unsafe ====================
# Roster service URL (identity.roster_url). Defaults to the original teacher's roster if unset.
# from identity.current.roster_url
ROSTER_SERVICE_URL=https://roster-production-12c1.up.railway.app

# Where the relay fetches the quiz curriculum: `<quiz_base>/data/curriculum.js`.
# from identity.current.quiz_base + "/data/curriculum.js"
CURRICULUM_URL=https://robjohncolson.github.io/apstat-park/quiz/data/curriculum.js

# `log` (record auth outcomes only) or `enforce`.
AI_GRADE_AUTH=log

# Teacher header secret for relay admin routes (Live Classroom sound switch etc.).
# secret; generated by setup.mjs (passphrase)
TEACHER_SECRET=

# ==================== Optional: tuning and extras ====================
# Third AI provider.
# secret
GEMINI_API_KEY=

# Optional hardening for roster admin proxy routes.
# secret
ROSTER_ADMIN_TOKEN=

# Presence expiry.
PRESENCE_TTL_MS=90000

# Presence resync interval.
PRESENCE_RESYNC_MS=30000

# Guest login log debounce.
GUEST_LOG_DEBOUNCE_MS=300000

# ==================== Feature flags ====================
# (none)

# ==================== Platform: injected by Railway, do not set by hand ====================
# Injected by Railway. Local default 3000.
# PORT=

# ==================== Test only: never set these in production ====================
# (none)
