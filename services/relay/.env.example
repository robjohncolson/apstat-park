# services/relay/.env.example
# GENERATED by `node scripts/check-env.mjs --render-examples` from config/env-schema.json. Do not edit by hand.
# Copy to services/relay/.env (gitignored), or run `node scripts/setup.mjs` to generate one with fresh secrets.
# Validate with: node scripts/check-env.mjs relay
# Railway: Root Directory = services/relay; health check path = /health.

# ==================== Required: the service does not work correctly without these ====================
# Core Supabase project URL (identity.supabase_url). Code has a default for the original project;
# set it anyway.
# from identity.current.supabase_url; format url
SUPABASE_URL=https://bzqbhtrurzzavhqbgqrs.supabase.co

# Core project anon key (public).
# from identity.current.supabase_anon_key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ6cWJodHJ1cnp6YXZocWJncXJzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTkxOTc1NDMsImV4cCI6MjA3NDc3MzU0M30.xDHsAxOlv0uprE9epz-M_Emn6q3mRegtTpFt0sl9uBo

# Core project service_role key. Server only.
# secret
SUPABASE_SERVICE_KEY=

# Same value as roster's ROSTER_TOKEN_SECRET, so the relay can verify student tokens.
# secret; must equal roster ROSTER_TOKEN_SECRET; 32+ bytes recommended
ROSTER_TOKEN_SECRET=

# Same value as roster's EFFECTIVE grader secret (roster's FRQ_GRADER_SECRET if set, else its
# ROSTER_GRADER_SECRET). Read by ai-grade-auth.js.
# secret; must equal roster ROSTER_GRADER_SECRET; 32+ bytes recommended
ROSTER_GRADER_SECRET=

# Same value as roster's. Read by apstat-park/campaign-key-grant.mjs.
# secret; must equal roster PARK_KEY_GRANT_SECRET; 32+ bytes recommended
PARK_KEY_GRANT_SECRET=

# The RELAY's own Ed25519 issuer key, base64 PKCS8 DER (signs AI review grants). Its base64url
# public key goes to roster's REVIEW_GRANT_PUBKEY.
# secret; generated by setup.mjs (ed25519, base64 PKCS8 DER); format ed25519-pkcs8-b64
RECEIPT_ISSUER_PRIVATE_KEY=

# AI provider for grading, appeals, tutor chat. At least one of GROQ_API_KEY / DEEPSEEK_API_KEY is
# required.
# secret; at least one of GROQ_API_KEY / DEEPSEEK_API_KEY
GROQ_API_KEY=

# Second AI provider (round-robin with failover).
# secret; at least one of GROQ_API_KEY / DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# ==================== Recommended: code defaults point at the ORIGINAL teacher's deployment or are unsafe ====================
# Roster service URL (identity.roster_url). Defaults to the original teacher's roster if unset.
# from identity.current.roster_url; format url
ROSTER_SERVICE_URL=https://roster-production-12c1.up.railway.app

# Where the relay fetches the quiz curriculum: `<quiz_base>/data/curriculum.js`.
# from identity.current.quiz_base + "/data/curriculum.js"; format url
CURRICULUM_URL=https://robjohncolson.github.io/apstat-park/quiz/data/curriculum.js

# `log` (record auth outcomes only) or `enforce`. Any other value means `off`.
AI_GRADE_AUTH=log

# Teacher header secret for relay admin routes (Live Classroom sound switch etc.).
# secret; generated by setup.mjs (passphrase)
TEACHER_SECRET=

# ==================== Optional: tuning and extras ====================
# Optional hardening for roster admin proxy routes.
# secret
ROSTER_ADMIN_TOKEN=

# Presence expiry.
PRESENCE_TTL_MS=90000

# Presence resync interval.
PRESENCE_RESYNC_MS=30000

# Guest login log debounce.
GUEST_LOG_DEBOUNCE_MS=300000

# AI grade routes: request body cap shared by all three routes (ai-grade-auth.js; the per-route keys
# below win).
AI_GRADE_MAX_BODY_BYTES=

# AI grade routes: prompt cap shared by /grade and /grade-batch.
AI_GRADE_MAX_PROMPT_BYTES=

# AI grade routes: answer cap shared by all three routes (code default 8192).
AI_GRADE_MAX_ANSWER_BYTES=

# /api/ai/grade body cap (code default 65536).
AI_GRADE_MAX_GRADE_BODY_BYTES=

# /api/ai/grade prompt cap (code default 49152).
AI_GRADE_MAX_GRADE_PROMPT_BYTES=

# /api/ai/grade answer cap.
AI_GRADE_MAX_GRADE_ANSWER_BYTES=

# /api/ai/grade-batch body cap (code default 393216).
AI_GRADE_MAX_BATCH_BODY_BYTES=

# /api/ai/grade-batch prompt cap (code default 32768).
AI_GRADE_MAX_BATCH_PROMPT_BYTES=

# /api/ai/grade-batch answer cap.
AI_GRADE_MAX_BATCH_ANSWER_BYTES=

# /api/ai/grade-worksheet body cap (code default 131072).
AI_GRADE_MAX_WORKSHEET_BODY_BYTES=

# /api/ai/grade-worksheet answer cap.
AI_GRADE_MAX_WORKSHEET_ANSWER_BYTES=

# AI grade rate limit per student id per minute (code default 30).
AI_GRADE_MAX_ITEMS_PER_MIN_SID=

# AI grade rate limit per IP per minute (code default 600).
AI_GRADE_MAX_ITEMS_PER_MIN_IP=

# Rate limiter memory cap; fallback for the two keys below.
AI_GRADE_MAX_TRACKED_KEYS=

# Rate limiter: max student ids tracked (code default 10000).
AI_GRADE_MAX_TRACKED_SIDS=

# Rate limiter: max IPs tracked (code default 2048).
AI_GRADE_MAX_TRACKED_IPS=

# ==================== Feature flags ====================
# (none)

# ==================== Platform: injected by Railway, do not set by hand ====================
# Injected by Railway. Local default 3000.
# PORT=

# ==================== Test only: never set these in production ====================
# (none)
